{
  "name": "psd-manager",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "test:logic": "node scripts/check-cleanup-regressions.mjs",
    "check:type": "tsc --noEmit",
    "check:build": "npm run build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:type && npm run test:logic && npm run verify-notes",
    "check:full": "npm run check && npm run check:build && npm run check:rust-format && npm run check:rust && npm run test:rust",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "verify-agent-note-tree": "node scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "node scripts/verify-agent-note-format.ts",
    "verify-archived": "node scripts/verify-archived-agent-notes.ts",
    "archive-agent-note": "node scripts/archive-agent-note.ts",
    "verify-notes": "npm run verify-agent-note-tree && npm run verify-agent-note-format && npm run verify-archived",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check:rust-format": "cargo fmt --check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "svelte": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.2",
    "@tsconfig/svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
